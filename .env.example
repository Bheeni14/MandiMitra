# ==============================================================================
# MandiMitra Environment Configuration
# Copy this file to .env and fill in your credentials. NEVER commit .env.
# ==============================================================================

# --- PostgreSQL / Supabase Database ---
# Example Supabase Transaction/Session Pooler URL:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- Supabase Storage (Raw Zone Object Storage) ---
# Credentials alone do NOT enable uploads. Keep RAW_STORAGE_UPLOAD_ENABLED=false
# unless you deliberately want remote raw-object uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mandimitra-raw
RAW_STORAGE_UPLOAD_ENABLED=false

# --- Open Government Data Platform India (Agmarknet Daily Prices) ---
# Get a free API key at https://data.gov.in/
DATA_GOV_IN_API_KEY=

# --- Google Gemini API (Grounded Bilingual Briefings) ---
# Get a free-tier key at https://aistudio.google.com/apikey
# Credentials alone do NOT enable Gemini. Keep GEMINI_ENABLED=false to use the
# deterministic bilingual template fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=false

# --- Advisor persistence (market_signals / briefings) ---
# Keep ADVISOR_PERSIST=false in production readiness. Demo Mode may still persist
# into the local SQLite warehouse; non-demo databases require this switch.
ADVISOR_PERSIST=false

# --- Application Mode & Logging ---
# Leave DEMO_MODE=auto to automatically use Demo Mode when DATABASE_URL is empty,
# or set DEMO_MODE=true / DEMO_MODE=false explicitly.
DEMO_MODE=auto
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
API_CACHE_TTL_HOURS=12

# --- FastAPI & Next.js Integration ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: also allow origins matching this regex (e.g. Vercel preview deployments)
CORS_ORIGIN_REGEX=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
